# Monorepo-wide fallback patterns. Each app under apps/ also carries its
# own .gitignore for stack-specific paths (node_modules, __pycache__, etc.)
# — see apps/deklar/.gitignore and apps/tullsyn/.gitignore.

# Environment
.env
.env.local
.env*.local

# Python (fallback)
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node (fallback)
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

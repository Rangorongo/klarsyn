# Copy to .env and fill in. Never commit .env (already gitignored).

# Postgres connection string. Recommend an EU-region host (Neon/Supabase) —
# this app stores Swedish residents' financial data. See open risk #6 in the spec.
DATABASE_URL="postgresql://user:password@localhost:5432/deklar?schema=public"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Email magic-link provider (Resend). https://resend.com
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Deklar <no-reply@deklar.se>"

# Anthropic Claude — used only for the three bounded AI tasks described in
# src/lib/ai (free-text interpretation, ambiguous-case flagging, guide-text polish).
ANTHROPIC_API_KEY=""

# AES-256-GCM master key for blob-level encryption of Underlag/AnswerSet/uploaded
# files (src/lib/storage/encryption.ts). 32 random bytes, base64-encoded:
#   openssl rand -base64 32
ENCRYPTION_MASTER_KEY=""

# Klarna Playground sandbox credentials (https://developers.klarna.com/documentation/testing/)
KLARNA_API_BASE_URL="https://api.playground.klarna.com"
KLARNA_USERNAME=""
KLARNA_PASSWORD=""

# Swish MSS (Merchant Swish Simulator) test environment
# (https://developer.swish.nu/documentation/environments). Requires mTLS client
# cert/key + CA cert files — store paths, not raw cert contents, in env.
SWISH_API_BASE_URL="https://mss.cpc.getswish.net/swish-cpcapi/api/v2"
SWISH_MERCHANT_SWISH_NUMBER=""
SWISH_CERT_PATH=""
SWISH_KEY_PATH=""
SWISH_CA_PATH=""
SWISH_CALLBACK_BASE_URL="" # must be a publicly reachable HTTPS URL — see open risk in spec
